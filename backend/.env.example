
# FILWORK - Configuration de l'application

NODE_ENV=development
PORT=5000
# Facultatif : interface d'ecoute. Par defaut 0.0.0.0 hors test.
# HOST=0.0.0.0

# FRONTEND ET CORS
# URL HTTPS du frontend en production (obligatoire sur Vercel).
FRONTEND_URL=http://localhost:5173

# Origines autorisees, separees par des virgules.
# En production : chaque origine listée doit utiliser HTTPS et être non locale
# (localhost, 127.0.0.1, ::1, 0.0.0.0 interdits — validés au démarrage).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AUTHENTIFICATION JWT

# Valeur fictive : generer un vrai secret aleatoire pour .env
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d

# BASE DE DONNEES POSTGRESQL - NEON
# Connexion runtime poolée (serveur) — endpoint contenant "-pooler",
# obligatoire en production : pgbouncer=true, connection_limit=5.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&pgbouncer=true&connection_limit=5

# Connexion directe (endpoint SANS "-pooler") utilisée exclusivement par Prisma CLI
# pour 'migrate deploy/status/diff'. Même branche et même base que DATABASE_URL.
# Doit être définie explicitement au moment de l'exécution de ces commandes.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# CONFIGURATION SMTP

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-your-smtp-password

# Adresse d'expedition des e-mails
MAIL_FROM="FILWORK <noreply@example.com>"

# CREATION DU PREMIER COMPTE ADMINISTRATEUR
# Variables lues uniquement par scripts/createAdmin.js.
# Le serveur HTTP ne les utilise pas : les retirer apres la creation.
FILWORK_ADMIN_EMAIL=admin@example.com
FILWORK_ADMIN_PASSWORD=replace-with-a-strong-password

# TESTS D'INTEGRATION
# Les tests utilisent une base dediee via TEST_DATABASE_URL.
# Cette variable appartient EXCLUSIVEMENT a backend/.env.test : ne pas la
# definir dans le fichier .env de l'application.
# Copier .env.test.example vers .env.test (ignore par Git).
# Ne jamais pointer TEST_DATABASE_URL vers la base de production.

# FILE D'ENVOI DES EMAILS (EMAIL OUTBOX)
# Le processeur démarre automatiquement avec le serveur (sauf en mode test).
# Mettre EMAIL_OUTBOX_ENABLED=false pour le désactiver et utiliser uniquement
# le script dédié : npm run emails:process (ou emails:process:once en cron).
# EMAIL_OUTBOX_ENABLED=true
# Intervalle entre deux traitements de la file, en millisecondes (default: 30000).
# EMAIL_OUTBOX_POLL_INTERVAL=30000
# Nombre maximum d'emails traités par lot (default: 3, borné pour les contraintes serverless).
# EMAIL_OUTBOX_BATCH_SIZE=3
# Nombre de tentatives max par email (default: 5).
# EMAIL_OUTBOX_MAX_ATTEMPTS=5

# SASPAY — PAIEMENT OFFICIEL DE FILWORK
# Désactivé tant que l'intégration n'est pas finalisée et autorisée.
# Le service refuse tout appel si cette valeur n'est pas "true",
# même en présence d'une clé API accidentellement configurée.
SASPAY_ENABLED=false
# URL de base de l'API SasPay (ne pas modifier sauf documentation officielle).
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Clé API secrète (vente encaissement). Ne jamais exposer côté client.
SASPAY_API_KEY=replace-with-your-saspay-api-key
# Secret de signature du webhook (affiché une seule fois à la création du webhook,
# dans le tableau de bord SasPay → Webhooks → Nouveau secret).
SASPAY_WEBHOOK_SECRET=replace-with-your-saspay-webhook-signing-secret
# Commission FILWORK en points de base (1 % = 100, 10 % = 1000).
# Valeur métier non fixée → 0 par défaut (aucune commission).
FILWORK_COMMISSION_BPS=0

# CONTRÔLE D'ACCÈS AUX TÂCHES INTERNES (VERCEL CRON)
# Secret partagé entre Vercel Cron et le backend pour les routes /api/internal/*.
# Générer au moins 16 caractères aléatoires. Sans cette variable, les routes internes refusent tout.
CRON_SECRET=replace-with-random-cron-secret-at-least-16-chars

# STOCKAGE DE FICHIERS
# STORAGE_PROVIDER: none | vercel-blob
STORAGE_PROVIDER=none
# BLOB_READ_WRITE_TOKEN : token statique du store Vercel Blob. Préférer la liaison OIDC du store au projet Vercel (injecté automatiquement par la plateforme, aucune valeur à gérer).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# STORAGE_TOKEN : alias rétro-compatible accepté si BLOB_READ_WRITE_TOKEN est absent.
# STORAGE_TOKEN=vercel_blob_rw_...
# STORAGE_BASE_URL=https://store.public.blob.vercel-storage.com
# STORAGE_MAX_UPLOAD_BYTES=5242880
# Pour une revue complète : docs/storage-provider.md