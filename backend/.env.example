
# FILWORK - Configuration de l'application

NODE_ENV=development
PORT=5000

# FRONTEND ET CORS
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AUTHENTIFICATION JWT

# Valeur fictive : generer un vrai secret aleatoire pour .env
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d

# BASE DE DONNEES POSTGRESQL - NEON
# Connexion utilisee par le backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Connexion utilisee par Prisma CLI et les migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# CONFIGURATION SMTP

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-your-smtp-password

# Adresse d'expedition des e-mails
MAIL_FROM="FILWORK <noreply@example.com>"