# FILWORK - Environnement de test isolé
#
# Copier ce fichier vers .env.test (ignoré par Git) puis renseigner
# TEST_DATABASE_URL avec la base de test locale ou la base Neon dédiée.
# Ne JAMAIS utiliser l'URL de production ici.

NODE_ENV=test
PORT=5051
API_BASE_URL=http://localhost:5051

# Base PostgreSQL dédiée aux tests d'intégration.
#
# IMPORTANT : ne jamais définir DATABASE_URL ni DATABASE_URL_UNPOOLED ici.
# Le garde-fou les considère comme des sources de production et compare
# TEST_DATABASE_URL à toutes les valeurs disponibles. En l'absence de toute
# source de production vérifiable, il refuse de poursuivre (fail-closed).
#
# Exemple PostgreSQL portable local :
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/filwork_test
# Exemple Neon dédié (branche ou base séparée) :
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# Obligatoire : renseigner manuellement une URL PostgreSQL dédiée aux tests.
# Ne pas inventer d'identifiants. Le garde-fou refuse toute cible identique
# à la production.
# Le nom de la base doit contenir un marqueur "test" delimite
# (ex. filwork_test, test_filwork, filwork_test_ci), sinon le client Prisma
# de test refuse de demarrer. Exception controlee pour une CI :
# TEST_ALLOW_NON_TEST_NAMED_DB=true.
TEST_DATABASE_URL=

# Options reservees aux CI controlees. Laisser commentees en local.
# TEST_ALLOW_NON_TEST_NAMED_DB=true
# TEST_ALLOW_OTHER_PORT=true
# TEST_ALLOW_REMOTE_API=true

# Secret JWT réservé aux tests. Ne pas réutiliser celui de la production.
# Générer une valeur aléatoire, par exemple :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-test-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP de test (facultatif). Laisser vide si les tests ne l'exigent pas.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-test-smtp-username
SMTP_PASS=replace-with-your-test-smtp-password
MAIL_FROM="FILWORK Test <noreply@example.com>"

# Comptes de test utilisés par les tests d'intégration.
# TEST_CREATOR_EMAIL=
# TEST_CREATOR_PASSWORD=
# TEST_COMPANY_EMAIL=
# TEST_COMPANY_PASSWORD=
# TEST_OTHER_COMPANY_EMAIL=
# TEST_OTHER_COMPANY_PASSWORD=
# Second compte créateur : nécessaire pour vérifier qu'un autre créateur
# ne peut ni répondre à un avis ni modifier la réponse.
# TEST_OTHER_CREATOR_EMAIL=
# TEST_OTHER_CREATOR_PASSWORD=
# TEST_CAMPAIGN_ID=
# TEST_OWNERSHIP_CAMPAIGN_ID=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
