{
  "name": "backend",
  "version": "1.0.0",
  "description": "API FILWORK",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "prisma generate",
    "start:test": "node scripts/startTestApi.js",
    "dev": "node --watch --watch-preserve-output src/server.js",
    "test": "node --test tests/http.test.js",
    "test:unit": "node --test tests/http.test.js",
    "test:integration": "node scripts/runIntegrationTests.js tests/api.test.js",
    "test:refresh-admin": "node scripts/runIntegrationTests.js tests/refresh-admin.test.js",
    "test:saspay": "node --test tests/saspay.test.js",
    "test:saspay-disabled": "node --test tests/saspay-disabled.test.js",
    "test:outbox": "node --test tests/email-outbox.test.js",
    "test:cron": "node --test tests/internal-cron.test.js",
    "test:payment-permissions": "node scripts/runIntegrationTests.js tests/payment-permissions.test.js",
    "test:payment-notifications": "node scripts/runIntegrationTests.js tests/payment-notifications.test.js",
    "test:campaign-notifications": "node scripts/runIntegrationTests.js tests/campaign-notifications.test.js",
    "test:production-env": "node --test tests/production-env.test.js",
    "test:prisma-cache": "node --test tests/prisma-cache.test.js",
    "test:reviews": "node scripts/runIntegrationTests.js tests/reviews.test.js",
    "test:communication": "node scripts/runIntegrationTests.js tests/communication.test.js",
    "test:all": "npm test && npm run test:saspay && npm run test:saspay-disabled && npm run test:outbox && npm run test:cron && npm run test:production-env && npm run test:prisma-cache && npm run test:integration && npm run test:reviews && npm run test:communication && npm run test:refresh-admin && npm run test:payment-permissions && npm run test:payment-notifications && npm run test:campaign-notifications",
    "emails:process": "node scripts/processEmailOutbox.js",
    "emails:process:once": "node scripts/processEmailOutbox.js --once",
    "db:test:status": "node scripts/checkTestDatabase.js && prisma migrate status --config prisma.test.config.js",
    "db:test:deploy": "node scripts/checkTestDatabase.js --connect && prisma migrate deploy --config prisma.test.config.js",
    "db:test:diff": "node scripts/checkTestDatabase.js && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script --config prisma.test.config.js",
    "cleanup:tokens": "node scripts/cleanupExpiredTokens.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
