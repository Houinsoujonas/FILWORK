generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CREATOR
  COMPANY
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  INVITATION_WITHDRAWN

  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  DELIVERABLE_REVISION_REQUESTED
  PAYMENT_STATUS_UPDATED
  COLLABORATION_COMPLETED
  COLLABORATION_CANCELLED

  ANNOUNCEMENT
  COLLABORATION_PROPOSED
}

enum CollaborationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

enum PaymentStatus {
  PLANNED
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CreatorAvailability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  FACEBOOK
  TWITCH
}

enum PortfolioItemType {
  IMAGE
  VIDEO
  LINK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creatorProfile      CreatorProfile?
  companyProfile      CompanyProfile?
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  reviewResponses     ReviewResponse[]
  notificationPreference NotificationPreference?
  announcements       Announcement[]
  refreshTokens       RefreshToken[]
  tokenVersion        Int @default(0)
  isActive            Boolean @default(true)
}

model CreatorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  displayName     String
  bio             String? @db.Text
  niche           String?
  location        String?
  profileImageUrl String?
  mediaKitUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  youtubeUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications       Application[]
  invitations Invitation[]
  country            String?
  city               String?
  startingRate       Decimal?            @db.Decimal(12, 2)
  rateCurrency       String              @default("XOF")
  availabilityStatus CreatorAvailability @default(AVAILABLE)

  creatorSocials CreatorSocial[]
  portfolioItems PortfolioItem[]
  reviews        Review[]

  payoutMsisdn       String?
  payoutNetwork      String?
  payoutCountry      String?
}

model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  industry    String?
  description String? @db.Text
  websiteUrl  String?
  logoUrl     String?
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  reviews      Review[]
  contactEmail String?
  contactPhone String?
  country      String?
  city         String?
}

model Campaign {
  id               String @id @default(cuid())
  companyProfileId String

  title        String
  description  String  @db.Text
  objectives   String? @db.Text
  deliverables String? @db.Text
  location     String?

  platforms String[] @default([])

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("XOF")

  startDate DateTime?
  endDate   DateTime?

  status      CampaignStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  applications   Application[]
  invitations Invitation[]

  @@index([companyProfileId])
  @@index([status, createdAt])
}

model Application {
  id               String @id @default(cuid())
  campaignId       String
  creatorProfileId String

  message String? @db.Text

  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  notifications  Notification[]
  collaboration  Collaboration?

  @@unique([campaignId, creatorProfileId])
  @@index([creatorProfileId, status])
  @@index([campaignId, status])
}

model Invitation {
  id               String @id @default(cuid())
  campaignId       String
  creatorProfileId String

  message String? @db.Text
  proposedAmount Decimal? @db.Decimal(12, 2)
currency       String   @default("XOF")

  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  notifications Notification[]
  collaboration Collaboration?

    @@index([campaignId, status])
  @@index([creatorProfileId, status])
  @@index([campaignId, creatorProfileId, status])
  @@unique([campaignId, creatorProfileId], where: raw("(status = ANY (ARRAY['PENDING'::\"InvitationStatus\", 'ACCEPTED'::\"InvitationStatus\"]))"), map: "Invitation_one_active_per_campaign_creator_key")
}

model Notification {
  id              String  @id @default(cuid())
  userId          String
  applicationId   String?
  invitationId    String?
  collaborationId String?
  announcementId  String?

  type    NotificationType
  title   String
  message String           @db.Text
  link    String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invitation    Invitation?   @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  announcement  Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([applicationId])
  @@index([invitationId])
  @@index([collaborationId])
  @@index([announcementId])
}

model Collaboration {
  id            String  @id @default(cuid())
  applicationId String? @unique
  invitationId  String? @unique

  agreedAmount Decimal? @db.Decimal(12, 2)
  currency     String   @default("XOF")

  status CollaborationStatus @default(ACTIVE)

  startDate DateTime  @default(now())
  endDate   DateTime?

  terms String? @db.Text

  cancellationReason String?   @db.Text
  cancelledByRole    UserRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  invitation  Invitation?  @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  deliverables  Deliverable[]
  payments      Payment[]
  notifications Notification[]
  review        Review?

  @@index([status, createdAt])
}

model Deliverable {
  id              String @id @default(cuid())
  collaborationId String

  title       String
  description String? @db.Text

  status DeliverableStatus @default(PENDING)

  dueDate     DateTime?
  submittedAt DateTime?
  assetUrl    String?
  feedback    String?   @db.Text
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, status])
  @@index([dueDate])
}

model Payment {
  id              String @id @default(cuid())
  collaborationId String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("XOF")

  status PaymentStatus @default(PLANNED)

  dueDate DateTime?
  paidAt  DateTime?

  reference String?
  notes     String? @db.Text

  provider             String   @default("MANUAL")
  providerTransactionId String? @unique
  providerReference    String?
  commissionBps        Int      @default(0)
  commissionAmount     Decimal? @db.Decimal(12, 2)
  creatorAmount        Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaboration    Collaboration      @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  sasPayTransactions SasPayTransaction[]

  @@index([collaborationId, status])
  @@index([dueDate])
  @@index([provider, status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RevokedToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CreatorSocial {
  id               String         @id @default(cuid())
  creatorProfileId String
  platform         SocialPlatform
  profileUrl       String
  followerCount    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, platform])
  @@index([platform])
}

model PortfolioItem {
  id               String @id @default(cuid())
  creatorProfileId String

  title        String
  description  String?           @db.Text
  type         PortfolioItemType
  url          String
  campaignName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, createdAt])
}

model Review {
  id               String @id @default(cuid())
  collaborationId  String @unique
  companyProfileId String
  creatorProfileId String

  rating  Int
  comment String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaboration  Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Restrict)
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Restrict)
  response       ReviewResponse?

  @@index([companyProfileId, createdAt])
  @@index([creatorProfileId, createdAt])
}

model ReviewResponse {
  id       String @id @default(cuid())
  reviewId String @unique
  authorId String

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
}

enum AnnouncementAudience {
  ALL
  CREATORS
  COMPANIES
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String             @db.Text
  audience    AnnouncementAudience @default(ALL)
  status      AnnouncementStatus @default(DRAFT)
  linkUrl     String?
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  notifications Notification[]

  @@index([status, publishedAt])
  @@index([audience])
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  payload   Json
  status    EmailOutboxStatus @default(PENDING)
  attempts  Int      @default(0)
  maxAttempts Int   @default(5)
  lastError String?  @db.Text
  nextAttemptAt DateTime @default(now())
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([to, createdAt])
}

model NotificationPreference {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  collaborationEmails Boolean @default(true)
  announcementEmails  Boolean @default(true)
  notificationEmails  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  tokenVersion        Int      @default(0)
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum SasPayDirection {
  PAYIN
  PAYOUT
}

enum SasPayStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model SasPayTransaction {
  id             String          @id @default(cuid())
  paymentId      String?
  direction      SasPayDirection
  reference      String?         @unique
  providerId     String?         @unique
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("XOF")
  status         SasPayStatus    @default(PENDING)
  network        String?
  msisdn         String?
  customerEmail  String?
  payload        Json?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([direction, status])
  @@index([paymentId])
}
